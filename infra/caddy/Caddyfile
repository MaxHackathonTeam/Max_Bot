# Заготовка этапа 0. Домен — из переменной DOMAIN.
{$DOMAIN} {
	encode zstd gzip

	@api path /api/* /bot/* /health /ready
	handle @api {
		reverse_proxy api:8000
	}

	# Обложки событий из volume media-data (имена уникальны, файлы не меняются).
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=2592000, immutable"
		file_server
	}

	handle {
		reverse_proxy web:80
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
