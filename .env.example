# Скопируй в .env и заполни. Значения секретов в репозиторий не коммитятся.
# Для локального запуска без токенов достаточно пустого .env (или его отсутствия).

ENV=local
PUBLIC_BASE_URL=
# Прод: домен для Caddy (без схемы) и пароль БД
DOMAIN=
POSTGRES_PASSWORD=

# MAX
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_API_BASE=https://platform-api2.max.ru
MAX_WEBHOOK_SECRET=
# webhook | polling
BOT_MODE=polling

# Хранилища (по умолчанию — сервисы из compose.yaml)
DATABASE_URL=
REDIS_URL=

# Доступ
JWT_SECRET=
# Через запятую
ADMIN_MAX_USER_IDS=

# GigaChat
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_OAUTH_URL=
GIGACHAT_API_URL=
GIGACHAT_MODEL=GigaChat
LLM_DAILY_TOKEN_BUDGET=200000

# Геокодеры и источники
DADATA_API_KEY=
DADATA_SECRET_KEY=
NOMINATIM_USER_AGENT=
PROCULTURE_API_KEY=

# Режимы
SEED_DEMO=1
OFFLINE_MODE=0
# DEV_AUTH=1 запрещён при ENV=prod — приложение не стартует
DEV_AUTH=0
REVIEW_MODE=0
# JSON: [{"login":"...","password":"...","role":"admin"}]
REVIEW_ACCOUNTS=
LOG_LEVEL=INFO
