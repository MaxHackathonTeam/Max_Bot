# Скопируй в .env и заполни. Значения секретов в репозиторий не коммитятся.
# Для локального запуска без токенов достаточно пустого .env (или его отсутствия).

ENV=local
PUBLIC_BASE_URL=
# CORS: через запятую, по умолчанию PUBLIC_BASE_URL
CORS_ORIGINS=
# Прод: домен для Caddy (без схемы) и пароль БД
DOMAIN=
POSTGRES_PASSWORD=

# MAX
# Локально бери токен ОТДЕЛЬНОГО тестового бота: один токен на проде и на ноутбуке —
# и локальный poller с webhook будут бороться за обновления, прод-бот замолчит.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_API_BASE=https://platform-api2.max.ru
MAX_WEBHOOK_SECRET=
# webhook | polling
BOT_MODE=polling
# 1 — локальный poller может снять webhook-подписку (опасно с боевым токеном).
# Без 1 poller webhook не трогает, а только пишет в лог, что он мешает.
BOT_POLLER_TAKEOVER=

# Хранилища (по умолчанию — сервисы из compose.yaml)
# DATABASE_URL — роль приложения afisha_app (без DDL, audit_log только INSERT):
#   postgresql+asyncpg://afisha_app:<APP_DB_PASSWORD>@db:5432/afisha
# MIGRATE_DATABASE_URL — владелец БД, только для миграций:
#   postgresql+asyncpg://afisha:<POSTGRES_PASSWORD>@db:5432/afisha
DATABASE_URL=
MIGRATE_DATABASE_URL=
APP_DB_PASSWORD=
REDIS_URL=

# Доступ
JWT_SECRET=
# Срок гостевого токена сайта (дней)
GUEST_JWT_TTL_DAYS=30
# Модераторы: MAX user_id через запятую, пробелы и лишние запятые допустимы (42, 43).
# Свой ID бот показывает по /whoami. Каждый модератор должен хоть раз нажать /start у бота.
ADMIN_MAX_USER_IDS=

# Режимы
SEED_DEMO=1
# DEV_AUTH=1 запрещён при ENV=prod — приложение не стартует
DEV_AUTH=0
REVIEW_MODE=0
# JSON: [{"login":"...","password":"...","role":"admin"}]
REVIEW_ACCOUNTS=
# Пример только для локального REVIEW_MODE (пароли задаются человеком в .env):
# REVIEW_ACCOUNTS='[{"login":"jury_user","password":"<свой-пароль>","role":"user"}]'
LOG_LEVEL=INFO
# Каталог обложек (volume media-data)
MEDIA_DIR=/app/media
